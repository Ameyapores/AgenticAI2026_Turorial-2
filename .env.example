# School staff will tell you which of these configurations to use.
# Copy this file to .env and fill in ONLY the matching provider settings.
# Never commit .env or paste your token into a notebook.

# Example A: Claude API
LAB_LLM_PROVIDER=anthropic
LAB_LLM_MODEL=REPLACE_WITH_SCHOOL_MODEL
ANTHROPIC_API_KEY=REPLACE_WITH_SCHOOL_KEY

# Example B: OpenAI API (comment A and uncomment B)
# LAB_LLM_PROVIDER=openai
# LAB_LLM_MODEL=REPLACE_WITH_SCHOOL_MODEL
# OPENAI_API_KEY=REPLACE_WITH_SCHOOL_KEY

# Example C: an OpenAI-compatible school gateway (comment A and uncomment C)
# LAB_LLM_PROVIDER=openai_compatible
# LAB_LLM_MODEL=REPLACE_WITH_SCHOOL_MODEL
# SCHOOL_LLM_API_BASE=https://REPLACE_WITH_SCHOOL_GATEWAY/v1
# SCHOOL_LLM_API_KEY=REPLACE_WITH_SCHOOL_KEY

LAB_MAX_MODEL_CALLS=12
