# School provides the exact API provider, endpoint (if any), key, and model ID.
# Duplicate this as a file named .env in the same directory.
LAB_LLM_PROVIDER=openai_compatible
LAB_LLM_MODEL=REPLACE_WITH_SCHOOL_MODEL_ID
SCHOOL_LLM_API_KEY=REPLACE_WITH_SCHOOL_KEY
SCHOOL_LLM_API_BASE=https://REPLACE_WITH_SCHOOL_ENDPOINT/v1

# For direct Anthropic, use LAB_LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY.
# For direct OpenAI, use LAB_LLM_PROVIDER=openai and OPENAI_API_KEY.
# LAB_LLM_MODEL is always required.
LAB_MAX_MODEL_CALLS=35
